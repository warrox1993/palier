root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_diagnostic.IDE0005.severity = error

# Nommage — conventions .NET
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_symbols.types.applicable_kinds = class,struct,enum,property,method
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.champs_prives.symbols = champs_prives
dotnet_naming_rule.champs_prives.style = underscore_camel
dotnet_naming_rule.champs_prives.severity = error
dotnet_naming_symbols.champs_prives.applicable_kinds = field
dotnet_naming_symbols.champs_prives.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Un nom de méthode de test porte le scénario, séparé par des traits de
# soulignement : c'est la convention xUnit, et la seule forme lisible dans un
# rapport d'échec. CA1707 vise le nommage d'une API publique publiée ; un projet
# de tests n'en publie aucune (`IsPackable` est faux). L'exception est étroite —
# limitée aux projets `*.Tests` et à cette seule règle — jamais globale.
#
# Le motif est `**.cs` et non `**/*.cs` : mesuré le 20/08/2026, la seconde forme
# ne couvre PAS la racine du projet de tests. `Palier.Domain.Tests/XTests.cs`
# sortait en `error CA1707` pendant que `Palier.Domain.Tests/Energie/XTests.cs`
# passait — le seul fichier de tests existant étant dans un sous-dossier, le
# trou était invisible, et le prochain fichier créé à l'endroit le plus naturel
# aurait cassé le build. Éprouvé aux deux profondeurs par `rigueur.test.mjs`.
[**/*.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

# CA1515 « rendez ce type interne » contredit FRONTALEMENT xUnit, qui n'énumère
# que les types publics. Mesuré le 20/08/2026 en rendant `RolesTests` interne :
# la compilation sort en code 1 sur `error xUnit1000: Test classes must be
# public` — et sur `error CA1812` au passage, xUnit instanciant ses classes par
# réflexion, invisible pour l'analyseur. Avec TreatWarningsAsErrors, les deux
# règles rendent le projet incompilable dans les deux sens : l'exception n'est
# pas un confort, c'est la seule sortie. Elle reste restreinte aux projets
# `*.Tests` et à cette seule règle.
dotnet_diagnostic.CA1515.severity = none

# CA2007 « appeler ConfigureAwait sur la tâche attendue » vise les
# BIBLIOTHÈQUES, dont l'appelant est inconnu et peut porter un contexte de
# synchronisation bloquant. Sa propre documentation le dit : « This rule is
# generally not applicable to application code ». Un assemblage de tests n'est
# consommé par personne, et `IsPackable` y est faux. Ajouter `.ConfigureAwait`
# à chaque `await` d'une suite d'intégration reviendrait à écrire une centaine
# de fois un mot qui ne protège de rien, et à noyer les lignes qui, elles,
# portent une assertion.
dotnet_diagnostic.CA2007.severity = none

# Les migrations EF Core sont du code ÉCRIT PAR UN OUTIL. `dotnet ef migrations
# add` produit un fichier que les analyseurs refusent en bloc — mesuré le
# 20/08/2026 sur `SocleInitial` : IDE0161 (espace de noms non inclus dans
# l'étendue du fichier), IDE0005 (using inutile), CA1062 (paramètre non vérifié)
# et CA1861 (tableaux constants) sortaient en erreur, et chaque migration future
# rouvrirait la liste. Corriger à la main un fichier régénéré à la commande
# suivante n'est pas une correction, c'est une dette qui se réécrit toute seule.
#
# `generated_code = true` est le mécanisme documenté par Roslyn pour ce cas
# exact : les analyseurs cessent de porter sur ces fichiers. Ce que le SQL écrit
# à la main dans ces migrations fait vraiment est éprouvé bien mieux qu'un
# analyseur ne le ferait — SchemaTests et IsolationTests l'exécutent sur un
# moteur réel, à chaque `npm run verify`.
# Le motif ne dit PAS `Migrations/*.cs`, et l'écart est mesuré. Avec le motif
# large, un fichier écrit à la main et déposé dans ce dossier cessait d'être
# analysé — y compris pour la mise en forme des espaces, et y compris quand on
# le NOMMAIT explicitement en argument de `dotnet format --include` : réponse
# « oui » à la question de D20 pour un cinquième outil. Le motif ne couvre donc
# que les deux formes qu'`ef migrations add` produit — `<horodatage>_<Nom>.cs`,
# son `.Designer.cs`, et le `ModelSnapshot`. Un fichier posé là à la main reste
# vu, et le témoin l'a confirmé : trois erreurs sur un fichier identique.
[**/Migrations/{*_*.cs,*ModelSnapshot.cs}]
generated_code = true

[*.{ts,tsx,js,jsx,json,md,yml,yaml}]
indent_size = 2

# Le SQL est la seule famille de fichiers du dépôt qu'AUCUN formateur ne
# couvre : Prettier n'a pas de parseur SQL natif, et `db/**/*.sql` est donc
# volontairement hors du glob de `format:scripts`. Ce bloc est tout ce qui
# tient la cohérence de style du SQL — il n'est pas décoratif, il remplace un
# outil absent.
[*.sql]
indent_size = 2
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
