{
  "name": "palier",
  "version": "1.0.0",
  "private": true,
  "description": "Application de suivi de musculation et de nutrition, pour éviter les excès et les blessures.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint --ignore-pattern \"tests/harness/fixtures/**\" .",
    "lint:fix": "oxlint --fix --ignore-pattern \"tests/harness/fixtures/**\"",
    "lint:types": "oxlint --type-aware --ignore-pattern \"tests/harness/fixtures/**\" src tests",
    "format": "prettier --write . \"!tests/harness/fixtures/**\"",
    "format:check": "prettier --check . \"!tests/harness/fixtures/**\"",
    "knip": "knip",
    "jscpd": "jscpd src",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "test": "vitest run --exclude \"tests/harness/accessibilite.test.ts\"",
    "test:harness": "vitest run tests/harness",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warrox1993/palier.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "bugs": {
    "url": "https://github.com/warrox1993/palier/issues"
  },
  "homepage": "https://github.com/warrox1993/palier#readme",
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jscpd": "^5.3.0",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
