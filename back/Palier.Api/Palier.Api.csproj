<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Palier.Domain\Palier.Domain.csproj" />
    <ProjectReference Include="..\Palier.Application\Palier.Application.csproj" />
    <ProjectReference Include="..\Palier.Infrastructure\Palier.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Les types de ce projet sont INTERNES : CA1515 refuse un type public dans un
      exécutable, et `AnalysisLevel: latest-all` avec `TreatWarningsAsErrors` en
      fait une erreur de compilation. Les rendre publics pour les éprouver serait
      l'inverse du bon geste — on affaiblirait l'assemblage pour le tester.
      L'épreuve de la configuration de production et celle de l'assertion de
      démarrage lisent donc l'assemblage de l'intérieur.
    -->
    <InternalsVisibleTo Include="Palier.Database.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

</Project>
